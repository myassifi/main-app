{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate --schema prisma/schema.postgres.prisma && tsc",
    "start": "prisma db push --schema prisma/schema.postgres.prisma && node dist/index.js",
    "railway:build": "prisma generate --schema prisma/schema.postgres.prisma && tsc",
    "railway:start": "(prisma migrate deploy --schema prisma/schema.postgres.prisma || prisma db push --schema prisma/schema.postgres.prisma) && node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
